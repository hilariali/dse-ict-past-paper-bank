# ---- AI proxy (/api/ai) ----
# Required: OpenAI-compatible base URL ending with /v1
AI_BASE_URL=https://lm.cwcc.app/v1
# Optional: model ID for the provider
AI_MODEL=qwen3.6-35b-a3b
# Optional: bearer token for provider auth
AI_API_KEY=

# ---- Firebase config endpoint (/api/firebase-config) ----
# Required
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Optional
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_MEASUREMENT_ID=
