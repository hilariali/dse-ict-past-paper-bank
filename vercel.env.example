# ---- AI proxy (/api/ai) ----
# Required: OpenAI-compatible base URL ending with /v1
AI_BASE_URL=
# Optional: model ID for the provider
AI_MODEL=
# Optional: bearer token for provider auth
AI_API_KEY=

# ---- Firebase config endpoint (/api/firebase-config) ----
# Required
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Optional
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_MEASUREMENT_ID=

# ---- Teacher / Admin Registration ----
# Optional (defaults to DSE_TEACHER_2025 and DSE_ADMIN_2025 if omitted)
TEACHER_ACCESS_KEY=DSE_TEACHER_2025
ADMIN_ACCESS_KEY=DSE_ADMIN_2025
